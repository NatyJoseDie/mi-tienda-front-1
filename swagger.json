{
  "openapi": "3.0.0",
  "paths": {
    "/productos/rapido": {
      "post": {
        "description": "Crea un producto con información mínima",
        "operationId": "ProductosController_crearProductoRapido",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Producto Ejemplo"
                  },
                  "precio_costo": {
                    "type": "number",
                    "example": 100
                  }
                },
                "required": [
                  "nombre",
                  "precio_costo"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Producto creado correctamente"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        },
        "summary": "Crear un producto rápido",
        "tags": [
          "productos"
        ]
      }
    },
    "/productos": {
      "post": {
        "description": "Crea un producto con toda la información y opcionalmente imágenes",
        "operationId": "ProductosController_crearProducto",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Camiseta Algodón"
                  },
                  "descripcion": {
                    "type": "string",
                    "example": "Camiseta 100% algodón, disponible en varios colores"
                  },
                  "precio_costo": {
                    "type": "number",
                    "example": 1500
                  },
                  "categoria": {
                    "type": "string",
                    "example": "Ropa"
                  },
                  "stock": {
                    "type": "number",
                    "example": 50
                  },
                  "sku": {
                    "type": "string",
                    "example": "CAM-001"
                  },
                  "unidad_id": {
                    "type": "number",
                    "example": 1,
                    "nullable": true
                  },
                  "imagenes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "description": "Imágenes del producto (máximo 5, formato imagen, 5MB máx. cada una)"
                  }
                },
                "required": [
                  "nombre",
                  "precio_costo",
                  "categoria",
                  "stock",
                  "sku"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Producto creado correctamente"
          },
          "400": {
            "description": "Datos de entrada inválidos"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        },
        "summary": "Crear un producto completo",
        "tags": [
          "productos"
        ]
      },
      "get": {
        "description": "Obtiene una lista de productos con filtros opcionales",
        "operationId": "ProductosController_listarProductos",
        "parameters": [
          {
            "name": "categoria",
            "required": false,
            "in": "query",
            "description": "Filtrar por categoría",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nombre",
            "required": false,
            "in": "query",
            "description": "Filtrar por nombre",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stock_min",
            "required": false,
            "in": "query",
            "description": "Filtrar por stock mínimo",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "conGanancia",
            "required": false,
            "in": "query",
            "description": "Incluir cálculo de ganancia en los productos",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de productos obtenida correctamente"
          }
        },
        "summary": "Listar productos",
        "tags": [
          "productos"
        ]
      }
    },
    "/productos/{id}": {
      "put": {
        "description": "Actualiza la información de un producto existente",
        "operationId": "ProductosController_actualizarProducto",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID del producto a actualizar",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Camiseta Algodón Premium"
                  },
                  "descripcion": {
                    "type": "string",
                    "example": "Camiseta 100% algodón orgánico"
                  },
                  "precio_costo": {
                    "type": "number",
                    "example": 1800
                  },
                  "categoria": {
                    "type": "string",
                    "example": "Ropa Premium"
                  },
                  "stock": {
                    "type": "number",
                    "example": 30
                  },
                  "sku": {
                    "type": "string",
                    "example": "CAM-002"
                  },
                  "unidad_id": {
                    "type": "number",
                    "example": 1,
                    "nullable": true
                  },
                  "activo": {
                    "type": "boolean",
                    "example": true
                  },
                  "imagenes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "description": "Imágenes del producto (máximo 5, formato imagen, 5MB máx. cada una)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Producto actualizado correctamente"
          },
          "404": {
            "description": "Producto no encontrado"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        },
        "summary": "Actualizar un producto",
        "tags": [
          "productos"
        ]
      },
      "get": {
        "description": "Devuelve la información detallada de un producto específico",
        "operationId": "ProductosController_obtenerProductoPorId",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID del producto a consultar",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Producto encontrado"
          },
          "404": {
            "description": "Producto no encontrado"
          }
        },
        "summary": "Obtener un producto por ID",
        "tags": [
          "productos"
        ]
      },
      "delete": {
        "description": "Marca un producto como inactivo (eliminación lógica)",
        "operationId": "ProductosController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID del producto a eliminar",
