    "/productos/admin/pedidos/{id}/estado": {
      "patch": {
        "description": "Actualiza el estado de un pedido existente",
        "operationId": "ProductosController_actualizarEstadoPedido",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID del pedido a actualizar",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "estado": {
                    "type": "string",
                    "example": "completado"
                  },
                  "entrega_manual": {
                    "type": "boolean",
                    "description": "Indica si es una entrega manual/externa"
                  }
                },
                "required": [
                  "estado"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado del pedido actualizado correctamente"
          },
          "400": {
            "description": "Datos de entrada inválidos"
          }
        },
        "summary": "Actualizar estado de un pedido",
        "tags": [
          "productos"
        ]
      },
      "put": {
        "description": "Actualiza el estado de un pedido con video de evidencia",
        "operationId": "ProductosController_actualizarEstadoPedidoConVideo",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID del pedido a actualizar",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "estado": {
                    "type": "string",
                    "description": "Nuevo estado del pedido",
                    "example": "enviado"
                  },
                  "video": {
                    "type": "string",
                    "format": "binary",
                    "description": "Video de evidencia (máximo 50MB)"
                  }
                },
                "required": [
                  "estado"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado del pedido actualizado correctamente con video"
          },
          "400": {
            "description": "Datos de entrada inválidos o video muy grande"
          },
          "404": {
            "description": "Pedido no encontrado"
          }
        },
        "summary": "Actualizar estado de un pedido con video",
        "tags": [
          "productos"
        ]
      }
    },
