    "/usuarios/pedido-consumidor": {
      "post": {
        "description": "Registra un nuevo pedido para un consumidor final",
        "operationId": "UsuariosController_registrarPedidoConsumidor",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Juan Pérez"
                  },
                  "email": {
                    "type": "string",
                    "example": "juan@example.com"
                  },
                  "telefono": {
                    "type": "string",
                    "example": "1234567890"
                  },
                  "direccion": {
                    "type": "string",
                    "example": "Calle Principal 123"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "producto_id": {
                          "type": "string"
                        },
                        "cantidad": {
                          "type": "number"
                        }
                      }
                    }
                  }
                },
                "required": [
                  "nombre",
                  "email",
                  "items"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pedido registrado correctamente"
          },
          "400": {
            "description": "Datos de entrada inválidos"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        },
        "summary": "Registrar pedido de consumidor final",
        "tags": [
          "usuarios"
        ]
      }
    },
